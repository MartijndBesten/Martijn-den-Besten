{
  // De Bijbelreis op een eigen adres: bijbelreis.nl. Alleen de atlas, zonder API of database.
  // Deploy: npm run build && node scripts/embed-assets.mjs && npx wrangler deploy -c wrangler.bijbelreis.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bijbelreis",
  "main": "./worker/bijbelreis.ts",
  "compatibility_date": "2026-10-13",
  "account_id": "c5472db2163a42a463916a6a525d8353",
  // bijbelreis.nl staat sinds 15-11-2026 op Cloudflare (zone actief); het adres op workers.dev is uit.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bijbelreis.nl", "custom_domain": true }, { "pattern": "www.bijbelreis.nl", "custom_domain": true }],
  "observability": { "enabled": true }
}
