{
  // De Bijbelreis op een eigen adres: bijbelreis.nl. Alleen de atlas, plus de bezoekmeting (POST /api/bezoek, tabel
  // `bezoek`, docs/bijbelreis-bezoek/README.md) en de aanvragen van bezoekers (POST /api/aanvraag, tabel `aanvraag`,
  // docs/bijbelreis-aanvraag/README.md) in de bestaande D1-database. De migraties worden via wrangler.embedded.jsonc
  // toegepast; hier staat daarom geen migrations_dir.
  // Secret: HASH_SECRET (voor de per dag wisselende bezoekershash; zonder blijft dat veld leeg).
  // Deploy: npm run build && node scripts/embed-assets.mjs && npx wrangler deploy -c wrangler.bijbelreis.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bijbelreis",
  "main": "./worker/bijbelreis.ts",
  "compatibility_date": "2026-10-13",
  "account_id": "c5472db2163a42a463916a6a525d8353",
  // bijbelreis.nl staat sinds 15-11-2026 op Cloudflare (zone actief); het adres op workers.dev is uit.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bijbelreis.nl", "custom_domain": true }, { "pattern": "www.bijbelreis.nl", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "martijndenbesten", "database_id": "d348e383-bcf1-4e08-b742-f85abe8fef2c" }],
  // Elke aanvraag van een bezoeker (POST /api/aanvraag) gaat ook als e-mail naar de maker. Dit vraagt Email Routing op
  // de zone bijbelreis.nl en info@denckh.nl als geverifieerd bestemmingsadres (docs/bijbelreis-aanvraag/README.md §6).
  "send_email": [{ "name": "MAIL", "destination_address": "info@denckh.nl" }],
  "observability": { "enabled": true }
}
