{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "martijndenbesten",
  "main": "./worker/embedded.ts",
  "compatibility_date": "2026-10-13",
  "account_id": "c5472db2163a42a463916a6a525d8353",
  "workers_dev": false,
  "preview_urls": false,
  // Strooizout voor de buurt heeft een eigen domein in dezelfde Worker (worker/strooizout-domein.ts); www verwijst door.
  "routes": [
    { "pattern": "martijndenbesten.com", "custom_domain": true },
    { "pattern": "strooizouthouten.nl", "custom_domain": true },
    { "pattern": "www.strooizouthouten.nl", "custom_domain": true }
  ],
  // Oude strooizout-adressen op martijndenbesten.com gaan permanent (301) naar strooizouthouten.nl.
  // STROOIZOUT_MAIL "aan": de webshop verstuurt e-mail (bevestiging na een bestelling, inlogcode voor het beheer).
  "vars": { "STROOIZOUT_DOORVERWIJZEN": "ja", "STROOIZOUT_MAIL": "aan" },
  // E-mail van de webshop, vanaf bestelling@strooizouthouten.nl naar klanten en naar de beheerder. Dit vraagt dat
  // strooizouthouten.nl in Cloudflare Email Service is aangemeld als verzenddomein (`wrangler email sending enable`);
  // zie docs/strooizout/README.md › E-mail. Wie op het beheer mag inloggen staat in het geheim STROOIZOUT_BEHEER_EMAILS.
  "send_email": [{ "name": "SZ_MAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "martijndenbesten",
      "database_id": "d348e383-bcf1-4e08-b742-f85abe8fef2c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
